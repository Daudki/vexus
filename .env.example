# --- App ---
APP_ENV=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generate-a-real-secret-before-any-non-local-use
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Database ---
# Local dev default (SQLite). Compose overrides this to Postgres automatically.
DATABASE_URL=sqlite:///./vexus_dev.db
POSTGRES_PASSWORD=vexus_dev_password

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Discovery safety ---
# Comma-separated CIDR ranges VEXUS is authorized to scan. Empty = no
# scanning permitted. Only set this to ranges you own or are explicitly
# authorized to assess.
AUTHORIZED_SCAN_RANGES=[]

# --- AI provider ---
# none | cloud | local
AI_PROVIDER=none
ANTHROPIC_API_KEY=

# --- Initial admin seed (optional, used by scripts/seed.py) ---
VEXUS_ADMIN_USERNAME=
VEXUS_ADMIN_EMAIL=
VEXUS_ADMIN_PASSWORD=

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5/minute
